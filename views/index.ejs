<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="/assets/styles/style.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>ChatBoi</title>
</head>

<body>
    <div class="wrapper">
        <header>
            <nav>
                <h1>ChatBoi</h1>
            </nav>
        </header>

        <main>
            <section>
                <% if (question) { %>

                    <article>
                        <div class="messages">
                            <ul id="ul_list">
                                <li>
                                    <%= question %>
                                </li>
                                <!-- <li>Hello there</li> -->
                                <!-- <li>General Kenobi</li> -->
                                <!-- <li>Lorem ipsum dolor sit amet consectetur adipisicing elit.quis quam quod ducimus, -->
                                    <!-- autem odit! Ea cumque reprehenderit obcaecati similique quod.</li> -->
                            </ul>
                        </div>
                    </article>
                    <% } %>

                    <article>
                        <div class="message">
                            <form method="POST" action="/ask">
                                <label for="question"></label>
                                <textarea id="question" name="question"
                                    placeholder="Stil dit spørgsmål..."></textarea>
                                <button id="submit-btn" type="submit">
                                    <i class="fa-solid fa-arrow-up"></i>
                                </button>
                            </form>
                        </div>
                    </article>
            </section>
        </main>
    </div>
</body>

</html>