<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="/assets/styles/style.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>ChatBoi</title>
</head>

<body>
    <div class="wrapper">
        <header>
            <nav>
                <h1>ChatBoi</h1>
            </nav>
        </header>

        <main>
            <section id="q_and_a">
                <% for (const message of messages) { %>
                    <article class="<%= message.type %>">
                        <p>
                            <%= message.text %>
                        </p>
                        <time>
                            <%= message.createdAt.toLocaleTimeString("da-DK") %>
                        </time>
                    </article>
                    <% } %>

                        <% if (error) { %>
                            <div id="alert">
                                <p role="alert">
                                    <%= error %>
                                </p>
                            </div>
                            <% } %>
            </section>

            <section id="message">
                <article>
                    <form method="POST" action="/ask">
                        <label for="question"></label>
                        <textarea id="question" name="question" placeholder="Stil dit spørgsmål..."></textarea>
                        <button id="submit-btn" type="submit">
                            <i class="fa-solid fa-arrow-up"></i>
                        </button>
                    </form>
                </article>
                <article>
                    <form method="POST" action="/clear-messages">
                        <button id="clear-messages" type="submit">Ryd beskeder</button>
                    </form>
                </article>
            </section>

            <section id="stats">
                <article>
                    <h2>Spørgsmål fordelt på emner:</h2>
                    <ul>
                        <li>Navn: <%= topicStats.navn %>
                        </li>
                        <li>Bosted: <%= topicStats.bosted %>
                        </li>
                        <li>Fritid: <%= topicStats.fritid %>
                        </li>
                    </ul>
                </article>
            </section>

        </main>
    </div>
</body>

</html>